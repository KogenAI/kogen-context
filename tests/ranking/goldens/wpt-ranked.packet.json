{"version":1,"operation":"search","query":"journal.shard","matches":[{"path":"tests/runner/main.zig","line":9,"column":59,"text":"        const jl = try std.fmt.allocPrint(allocator, \"{s}/journal.shard{d}.jsonl\", .{ dir, i });"},{"path":"tools/site/render.py","line":4,"column":19,"text":"SHARD_JOURNALS = 'journal.shard*.jsonl'"},{"path":"tools/site/render.py","line":14,"column":50,"text":"    return html + '<p>Each runner writes its own journal.shard file.</p>'"},{"path":"tests/runner/options_test.zig","line":3,"column":28,"text":"test \"a shard's journal is journal.shard<k>.jsonl\" {"},{"path":"tests/runner/options_test.zig","line":4,"column":45,"text":"    try std.testing.expectEqualStrings(\"out/journal.shard1.jsonl\", \"out/journal.shard1.jsonl\");"},{"path":"tests/runner/main.zig","line":8,"column":46,"text":"        // Each shard keeps its own journal (journal.shard<i>.jsonl)."},{"path":"tools/site/render.py","line":13,"column":35,"text":"    # A sweep's chunks each write journal.shard<k>.jsonl."},{"path":"docs/lessons/stream-names.md","line":3,"column":49,"text":"**Lesson**: a chunk with several runners writes journal.shard<k>.wptreport.jsonl."},{"path":"docs/lessons/stream-names.md","line":4,"column":45,"text":"**Why**: each runner streams beside its own journal.shard<k>.jsonl."},{"path":"docs/lessons/stream-names.md","line":5,"column":37,"text":"**What Happened**: a reader globbed journal.shard*.jsonl and missed one-runner chunks."},{"path":"docs/lessons/stream-names.md","line":6,"column":38,"text":"**Fix**: read both journal.jsonl and journal.shard*.jsonl."},{"path":"docs/lessons/stream-names.md","line":7,"column":15,"text":"**Takeaway**: journal.shard is the several-runner layout."}],"truncated":true,"limits":{"max_matches":12,"max_line_chars":500}}
